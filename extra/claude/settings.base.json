{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": true,
  "tui": "fullscreen",
  "feedbackSurveyRate": 0,
  "permissions": {
    "deny": [
      "Workflow",
      "SendFeedback"
    ],
    "allow": [
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(go *)",
      "Bash(bd *)",
      "Bash(wait)",
      "Skill(beads)",
      "Skill(commit)",
      "WebSearch",
      "Read(~/.dotfiles/core/ai/skills/commit/scripts/commit-scopes.sh)",
      "Bash(~/.dotfiles/core/ai/skills/commit/scripts/commit-scopes.sh *)",
      "Read(/Users/david/.dotfiles/core/ai/skills/commit/scripts/commit-scopes.sh)",
      "Bash(/Users/david/.dotfiles/core/ai/skills/commit/scripts/commit-scopes.sh *)",
      "Bash(gofmt -l *)",
      "Bash(kitty @ ls*)"
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}
